# Copy to .env or let scripts/setup.sh generate it with random values.
# Never commit .env.

# Password of the neo4j user. Used by the neo4j container, the seed job and every business service.
NEO4J_PASSWORD=

# 32 random bytes, base64. AES-GCM key that encrypts TOTP secrets at rest in the graph.
TOTP_ENC_KEY=
